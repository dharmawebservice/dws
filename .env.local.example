# Supabase (free tier) — get from https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Secret admin URL token — visit /admin-dws2024 to open admin panel
# Change this to something only you know!
ADMIN_SECRET_TOKEN=dws-admin-2024

# Admin password for the secret panel
ADMIN_PASSWORD=your_strong_password_here

# JWT secret for session tokens
JWT_SECRET=your_jwt_secret_minimum_32_chars_here

# Formspree endpoint for contact form (optional)
NEXT_PUBLIC_FORMSPREE_ID=your_formspree_id
